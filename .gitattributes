# 自动检测文本文件并规范化行尾
* text=auto

# 二进制文件（不进行文本转换）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ogg binary
*.ttf binary
*.apk binary
*.jar binary
*.zip binary
*.tar.gz binary

# Gradle
*.gradle text eol=lf
gradlew text eol=lf
*.bat text eol=crlf

# 源代码
*.java text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Shell 脚本
*.sh text eol=lf

# Windows 批处理
*.bat text eol=crlf
*.cmd text eol=crlf

# 存档文件不应提交
saves/*.db export-ignore
